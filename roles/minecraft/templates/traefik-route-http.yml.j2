http:
  routers:
    dynmap-{{ capsule_id }}:
      rule: "Host(`minecraft.{{ racine_slug }}.homegalaxy.io`)"
      entryPoints:
        - websecure
      service: dynmap-{{ capsule_id }}-svc
      tls:
        certResolver: cloudflare
      middlewares:
        - secure-headers
  services:
    dynmap-{{ capsule_id }}-svc:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:{{ dynmap_port }}"
