tcp:
  routers:
    minecraft-{{ capsule_id }}:
      rule: "HostSNI(`*`)"
      entryPoints:
        - minecraft
      service: minecraft-{{ capsule_id }}-svc
  services:
    minecraft-{{ capsule_id }}-svc:
      loadBalancer:
        servers:
          - address: "minecraft-{{ capsule_id }}:25565"
