{#- Hostnames calculés par la BOX (party 2026-07-29) — la politique de
    nommage ne vit PLUS ici : `{sub}_host` = canonique
    `{sub}-{capsule_slug}.{racine}.homegalaxy.io` (unique par capsule),
    `{sub}_host_alias` = alias court, servi uniquement pour la capsule
    générale. Le `default()` est le repli si la box est plus ancienne que
    ce SHA de recette (le catalogue et la box évoluent séparément). -#}
http:
  routers:
    adguard-{{ capsule_id }}:
      rule: "Host(`{{ adguard_host | default('adguard.' ~ racine_slug ~ '.homegalaxy.io') }}`){{ ' || Host(`' ~ adguard_host_alias ~ '`)' if adguard_host_alias is defined and adguard_host_alias else '' }}"
      entryPoints:
        - websecure
      service: adguard-{{ capsule_id }}-svc
      tls:
        certResolver: cloudflare
      middlewares:
        - secure-headers
  services:
    adguard-{{ capsule_id }}-svc:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:{{ adguard_port }}"
